---
interface Props { size?: 'header' | 'footer' }
const { size = 'header' } = Astro.props;
const word = size === 'footer' ? 19 : 21;
---
<span class="logo">
  <svg width="54" height="42" viewBox="0 0 54 42" aria-hidden="true" style="flex-shrink:0">
    <circle cx="27" cy="16" r="8" fill="#F5B92E"></circle>
    <g stroke="#F5B92E" stroke-width="2.4" stroke-linecap="round">
      <path d="M27 3.5V1"></path><path d="M14 16h-2.6"></path><path d="M42.6 16H40"></path>
      <path d="M17.8 6.8 16 5"></path><path d="M36.2 6.8 38 5"></path>
    </g>
    <path d="M2 31c9-7 19-7 25-3.5S44 33 52 27v7c-8 6-19 2-25-1.5S11 30 2 37z" fill="#0B6E3C"></path>
  </svg>
  <span style="display:block">
    <span class="logo-word" style={`font-size:${word}px`}>JAMAICA <span>SOLAR</span></span>
    <span class="logo-sub">Powering a brighter Jamaica</span>
  </span>
</span>
