---
import { initials, type Provider } from '../lib/data';
interface Props { p: Provider; size?: number; round?: boolean }
const { p, size = 84, round = false } = Astro.props;
const radius = round ? '999px' : '10px';
---
{p.logo
  ? <div class="avatar avatar-logo" style={`width:${size}px; height:${size}px; border-radius:${radius}`}>
      <img src={p.logo} alt={`${p.name} logo`} loading="lazy" width={size} height={size} />
    </div>
  : <div class="avatar" style={`width:${size}px; height:${size}px; border-radius:${radius}; font-size:${Math.round(size * 0.3)}px`} aria-hidden="true">{initials(p.name)}</div>}
