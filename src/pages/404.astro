---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="wrap" style="max-width:720px; padding-top:72px; padding-bottom:96px; text-align:center">
    <div class="kicker">404</div>
    <h1 class="h1">We couldn’t find that page</h1>
    <p class="lede" style="margin-left:auto; margin-right:auto">It may have moved, or the link may be wrong. Try one of these instead.</p>
    <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap">
      <a href="/" class="btn btn-sun">Home</a>
      <a href="/companies/" class="btn btn-outline-green">Find a provider</a>
      <a href="/learn/" class="btn btn-outline-green">Learn</a>
    </div>
  </div>
</Base>
