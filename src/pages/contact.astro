---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" section="about">
  <div class="wrap" style="max-width:808px; padding-top:48px; padding-bottom:80px">
    <h1 class="h1">Contact us</h1>
    <p class="lede">Corrections, listing questions, sponsorship or partnership enquiries — we read everything.</p>
    <div class="grid-3">
      <a href="/list-your-business/" class="guide-card"><div class="k">Businesses</div><div class="t">List or claim your business</div><div class="d">Free listings and corrections.</div></a>
      <div class="guide-card"><div class="k">Email</div><div class="t">hello@jamaicasolar.com.jm</div><div class="d">Placeholder — set up this mailbox before launch.</div></div>
      <a href="/methodology/" class="guide-card"><div class="k">How we work</div><div class="t">Methodology &amp; disclosure</div><div class="d">Listings, badges and sponsorship.</div></a>
    </div>
  </div>
</Base>
