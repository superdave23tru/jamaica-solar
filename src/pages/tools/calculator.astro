---
import Base from '../../layouts/Base.astro';
import { PARISHES } from '../../lib/data';
// Default assumptions carried over from the design mockup. Confirm against current JPS tariffs and installer prices before launch.
const A = { rate: 47, costPerKw: 355000, fixed: 180000, sunHours: 4.6, inflation: 0.06, offset: 0.82 };
---
<Base title="Solar payback calculator" description="Estimate solar system size, installed cost, payback and 10-year savings in Jamaican dollars from your monthly JPS bill." section="tools">
  <div class="wrap pad-section">
    <h1 class="h1">Solar payback calculator</h1>
    <p class="lede">A rough estimate in Jamaican dollars, based on your JPS bill. Not affiliated with any company listed on this site.</p>
    <div class="calc-grid" data-calc data-a={JSON.stringify(A)}>
      <div class="calc-in">
        <div style="margin-bottom:26px">
          <label class="l" for="bill">Average monthly JPS bill</label>
          <div class="big" data-bill-label>J$25,000</div>
          <input id="bill" type="range" min="8000" max="120000" step="1000" value="25000" data-bill />
          <div style="display:flex; justify-content:space-between; font-size:12.5px; color:#8A99AC; margin-top:6px"><span>J$8,000</span><span>J$120,000</span></div>
        </div>
        <div style="margin-bottom:24px">
          <label class="l" for="parish">Parish</label>
          <select id="parish" data-parish>{PARISHES.map(p => <option value={p}>{p}</option>)}</select>
        </div>
        <div>
          <div class="l" style="font-weight:600; font-size:15px; color:#14324F; margin-bottom:10px">Roof type</div>
          <div style="display:flex; flex-direction:column; gap:8px">
            {['Concrete slab', 'Zinc / metal sheet', 'Clay or concrete tile'].map((r, i) => <button type="button" class="opt" data-roof={r} aria-pressed={i === 0 ? 'true' : 'false'}>{r}</button>)}
          </div>
        </div>
        <details style="margin-top:24px; font-size:14.5px; color:#5C6B80">
          <summary style="cursor:pointer; font-weight:600; color:#14324F">Adjust assumptions</summary>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:12px">
            <div class="field"><label for="rate">Electricity rate (J$/kWh)</label><input id="rate" type="number" min="20" max="90" step="1" value={A.rate} data-rate /></div>
            <div class="field"><label for="cpk">Installed cost (J$/kW)</label><input id="cpk" type="number" min="150000" max="600000" step="5000" value={A.costPerKw} data-cpk /></div>
          </div>
        </details>
      </div>
      <div class="calc-out">
        <div class="k">Your estimate</div>
        <div class="res">
          <div><div class="rl">System size</div><div class="rv" data-o-kw>—</div></div>
          <div><div class="rl">Payback period</div><div class="rv" data-o-pay>—</div></div>
          <div><div class="rl">Installed cost range</div><div class="rv sm" data-o-cost>—</div></div>
          <div><div class="rl">10-year savings</div><div class="rv sm" data-o-save>—</div></div>
        </div>
        <div class="warn" data-cap hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F5B92E" stroke-width="2.2" style="flex-shrink:0; margin-top:2px"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.6v5.6"></path><path d="M12 16.6v.2"></path></svg>
          <div><div class="wt">Over the 10 kW net billing cap</div><div class="ws">Homes can only sell surplus power to JPS on systems up to 10 kW. A larger system would need an export-limited (auxiliary) connection, and a battery becomes more valuable. <a href="/learn/net-billing/#cap" style="color:#F5B92E; text-decoration:underline">Read about the cap</a></div></div>
        </div>
        <div class="warn" data-study hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F5B92E" stroke-width="2.2" style="flex-shrink:0; margin-top:2px"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.6v5.6"></path><path d="M12 16.6v.2"></path></svg>
          <div><div class="wt">Detailed study likely required</div><div class="ws" data-study-msg></div></div>
        </div>
        <div style="height:1px; background:#1E4577; margin:26px 0 20px"></div>
        <div class="assump">Assumes <span data-a-rate>J$47</span> per kWh, <span data-a-cpk>J$355,000</span> per kW plus a J$180,000 fixed allowance for mounting, wiring and permits, 4.6 peak sun hours, 82% of your bill offset and 6% annual electricity inflation. Estimates only — always compare written quotes. <a href="/methodology/#calculator">See methodology</a></div>
        <a href="/quote/" class="btn btn-sun btn-sq btn-block" style="margin-top:24px" data-o-cta>Get quotes for this system</a>
      </div>
    </div>
  </div>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-calc]')!;
  const A = JSON.parse(root.dataset.a!);
  const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const bill = $<HTMLInputElement>('[data-bill]'), rateIn = $<HTMLInputElement>('[data-rate]'), cpkIn = $<HTMLInputElement>('[data-cpk]');
  const parish = $<HTMLSelectElement>('[data-parish]');
  const roofs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-roof]'));
  let roof = 'Concrete slab';
  const money = (n: number) => 'J$' + Math.round(n).toLocaleString('en-US');
  const short = (n: number) => n >= 1e6 ? 'J$' + (n / 1e6).toFixed(n >= 1e7 ? 0 : 2).replace(/\.00$/, '') + 'M' : money(n);

  function calc() {
    const b = Number(bill.value), rate = Number(rateIn.value) || A.rate, cpk = Number(cpkIn.value) || A.costPerKw;
    const kw = Math.max(1, (b / rate) / (A.sunHours * 30));
    const kwR = Math.round(kw * 10) / 10;
    const cost = A.fixed + kwR * cpk;
    const annual = b * 12 * A.offset;
    let cum = 0, esc = 1; for (let y = 0; y < 10; y++) { cum += annual * esc; esc *= 1 + A.inflation; }
    $('[data-bill-label]').textContent = money(b);
    $('[data-o-kw]').textContent = kwR.toFixed(1) + ' kW';
    $('[data-o-pay]').textContent = (cost / annual).toFixed(1) + ' yrs';
    $('[data-o-cost]').textContent = short(cost * 0.9) + ' – ' + short(cost * 1.1);
    $('[data-o-save]').textContent = short(cum);
    $('[data-a-rate]').textContent = money(rate);
    $('[data-a-cpk]').textContent = money(cpk);
    $('[data-cap]').hidden = kwR <= 10;
    const study = kwR >= 10 || roof === 'Clay or concrete tile';
    $('[data-study]').hidden = !study;
    $('[data-study-msg]').textContent = kwR >= 10
      ? `At ${kwR.toFixed(1)} kW this is a larger installation. Expect a detailed site study — structural load, supply capacity and a longer JPS interconnection review — before a firm price.`
      : 'Clay and concrete tile roofs usually need a detailed site study: tile removal, mounting method and waterproofing all affect the final price.';
    roofs.forEach(r => r.setAttribute('aria-pressed', String(r.dataset.roof === roof)));
    const cta = $<HTMLAnchorElement>('[data-o-cta]');
    cta.textContent = `Get quotes for a ${kwR.toFixed(1)} kW system`;
    cta.href = `/quote/?parish=${encodeURIComponent(parish.value)}&kw=${kwR.toFixed(1)}`;
  }
  [bill, rateIn, cpkIn].forEach(i => i.addEventListener('input', calc));
  parish.addEventListener('change', calc);
  roofs.forEach(r => r.addEventListener('click', () => { roof = r.dataset.roof!; calc(); }));
  calc();
</script>
