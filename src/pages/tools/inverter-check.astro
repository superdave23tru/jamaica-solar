---
import Base from '../../layouts/Base.astro';
import { inverters } from '../../lib/data';
const brands = [...new Set(inverters.map(i => i.brand))].sort();
const rows = [...inverters].sort((a, b) => a.brand.localeCompare(b.brand) || (a.kw ?? 0) - (b.kw ?? 0));
---
<Base title="Is my inverter BSJ-approved?" description="Search the Bureau of Standards Jamaica list of approved solar inverters by brand or model before you buy or sign a quote." section="tools">
  <div class="wrap pad-section">
    <div class="kicker">Equipment check</div>
    <h1 class="h1">Is my inverter BSJ-approved?</h1>
    <p class="lede">To connect a solar system to the JPS grid, the inverter must be on the Bureau of Standards Jamaica (BSJ) approved list. Type the brand or model from your quote.</p>

    <label class="sr-only" for="q">Inverter brand or model</label>
    <input id="q" class="search-in" type="search" placeholder="e.g. Deye Sun-8K, Sol-Ark 15K, Growatt MTL" autocomplete="off" data-q />
    <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:center; margin:14px 0 22px; font-size:14.5px; color:#5B6B63">
      <select class="select" style="min-width:200px; padding:10px 12px" data-brand aria-label="Brand">
        <option value="">All {brands.length} brands</option>
        {brands.map(b => <option value={b}>{b}</option>)}
      </select>
      <select class="select" style="min-width:200px; padding:10px 12px" data-size aria-label="Size">
        <option value="">All sizes</option>
        <option>Residential (&lt;=15kW)</option>
        <option>Commercial (15-100kW)</option>
        <option>Micro / module-level</option>
        <option>Utility / large C&amp;I (&gt;100kW)</option>
      </select>
      <label style="display:inline-flex; gap:8px; align-items:center; cursor:pointer"><input type="checkbox" data-hybrid /> Battery / hybrid capable only</label>
      <span style="margin-left:auto" data-count></span>
    </div>

    <div class="callout" data-tip style="margin-top:0">
      <strong>Tip:</strong> match the <em>exact</em> model. Approvals are often for a specific variant (for example “-US” for 120/240V split-phase vs “-EU” for 230V). If your model is close but not identical, ask the installer for the BSJ approval report number.
    </div>

    <div style="overflow:auto; border:1px solid #D9E0DB; border-radius:12px; max-height:70vh">
      <table class="dtable">
        <thead><tr><th>Brand</th><th>Model</th><th>Output</th><th class="hide-sm">AC voltage</th><th>Status</th><th class="hide-sm">Approved</th><th class="hide-sm">BSJ report</th></tr></thead>
        <tbody>
          {rows.map(i => (
            <tr data-row data-k={(i.brand + ' ' + i.model + ' ' + i.key).toLowerCase().replace(/[^a-z0-9. ]/g, '')} data-b={i.brand} data-s={i.size} data-h={i.hybrid ? '1' : '0'}>
              <td style="font-weight:600; color:#15211C">{i.brand}</td>
              <td>{i.model}{i.issue && <div style="font-size:12px; color:#8A5A00; margin-top:3px" title={i.issue}>⚠ {i.issue.split(';')[0]}</div>}</td>
              <td style="white-space:nowrap">{i.kw != null ? `${i.kw} kW` : '—'}{i.hybrid && <div style="font-size:12px; color:#0B5239">Hybrid / battery</div>}</td>
              <td class="hide-sm">{i.voltage}</td>
              <td class={i.status === 'Approved' ? 'status-ok' : 'status-cond'}>{i.status}</td>
              <td class="hide-sm" style="white-space:nowrap">{i.date}</td>
              <td class="hide-sm" style="font-size:12.5px">{i.report}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="empty" data-none hidden style="margin:16px; border-radius:10px">
        <strong style="color:#15211C">No match on the BSJ list.</strong> That does not always mean the model is unapproved — the list may spell it differently. Ask your installer for the BSJ approval report number, or contact BSJ.
      </div>
    </div>
    <p class="small" style="margin-top:16px; line-height:1.6">Source: Bureau of Standards Jamaica, Electrical &amp; Electronics Branch — approved inverter list (read 16 October 2026). We corrected obvious typos for search only and flag rows where the published figures look inconsistent; the BSJ list is the official record. “Hybrid / battery” is inferred from the model name. Conditional approval “limited use” (FLU) means the model is approved for limited use in Jamaica only.</p>
  </div>
</Base>

<script>
  const q = document.querySelector<HTMLInputElement>('[data-q]')!;
  const brand = document.querySelector<HTMLSelectElement>('[data-brand]')!;
  const size = document.querySelector<HTMLSelectElement>('[data-size]')!;
  const hyb = document.querySelector<HTMLInputElement>('[data-hybrid]')!;
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('[data-row]'));
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const none = document.querySelector<HTMLElement>('[data-none]')!;
  const norm = (s: string) => s.toLowerCase().replace(/sgo/g, 'sg0').replace(/[^a-z0-9. ]/g, '');
  function apply() {
    const terms = norm(q.value).split(/\s+/).filter(Boolean);
    let n = 0;
    rows.forEach(r => {
      const k = r.dataset.k!, kc = k.replace(/[ .]/g, '');
      const ok = terms.every(t => k.includes(t) || kc.includes(t.replace(/[ .]/g, ''))) &&
        (!brand.value || r.dataset.b === brand.value) && (!size.value || r.dataset.s === size.value) && (!hyb.checked || r.dataset.h === '1');
      r.hidden = !ok; if (ok) n++;
    });
    count.textContent = `${n} model${n === 1 ? '' : 's'}`;
    none.hidden = n > 0;
  }
  [q, brand, size, hyb].forEach(el => el.addEventListener('input', apply));
  const pre = new URLSearchParams(location.search).get('q'); if (pre) q.value = pre;
  apply();
</script>
